    <joint name="right_finger_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find gp7_description)/config/controllers.yaml</parameters>
    </plugin>

    <!-- Rigidly locks box_b to the wrist during transit (zero slipping or throwing) -->
    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>link6</parent_link>
      <child_model>box_b</child_model>
      <child_link>link</child_link>
      <detach_topic>/box_b/detach</detach_topic>
      <attach_topic>/box_b/attach</attach_topic>
      <output_topic>/box_b/state</output_topic>
    </plugin>
  </gazebo>

  <gazebo reference="left">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
  </gazebo>

  <gazebo reference="right">
